OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Optional server-only Google Maps Platform key for approximate-area Places and walking routes
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_DEMO_MODE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="Anjurentals <noreply@your-verified-domain.com>"
# Optional comma-separated recipients for API usage alerts. If blank, verified admin accounts receive alerts.
ADMIN_ALERT_EMAIL=
SITE_CONTACT_EMAIL=
CONTACT_RECIPIENT_EMAIL=
FEEDBACK_RECIPIENT_EMAIL=
APP_URL=http://localhost:3010
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/auth/google/callback
ANDROID_APP_SHA256_CERT_FINGERPRINT=
APPLE_TEAM_ID=
DATABASE_URL=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
# Optional browser push notifications. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@anjurentals.com
# Optional Android native push delivery. Store the Firebase service-account JSON as a server-only secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required by the Vercel scheduled saved-search and lifecycle alert jobs
CRON_SECRET=
# Optional price shown for the owner-alert add-on; payment confirmation is admin-controlled until a checkout provider is connected.
LISTING_NOTIFICATION_ADDON_PRICE_CENTS=
# Server-only key used to encrypt audit-log IP addresses. Use a long random value.
AUDIT_LOG_ENCRYPTION_KEY=
