{
  "name": "rental-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync",
    "cap:android:open": "npx cap open android",
    "cap:android:run": "npx cap run android",
    "cap:android:debug": "npx cap sync && cd android && gradlew.bat assembleDebug",
    "cap:android:release": "npx cap sync && cd android && gradlew.bat bundleRelease",
    "test": "node --test --experimental-strip-types scripts/location-context-rules.test.mjs scripts/listing-quality.test.mjs scripts/renter-application.test.mjs scripts/owner-operations.test.mjs scripts/saved-search-alerts.test.mjs",
    "db:seed": "node scripts/seed-sample-data.mjs",
    "db:seed:agents": "node scripts/seed-agent-directory.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "google-auth-library": "^11.0.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5.0.0"
  }
}
